# ==============================================================================
# CareerPulse — Environment Configuration
# ==============================================================================

ENVIRONMENT=development
PORT=5000
HOST=0.0.0.0

# LLM Provider for Custom Outreach & Resume Tailoring (Optional, falls back to deterministic rule engine)
LLM_PROVIDER=mock # mock | openai
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# Matching Engine Thresholds
DEFAULT_MATCH_THRESHOLD=0.70
KEYWORD_WEIGHT=0.45
SEMANTIC_WEIGHT=0.55
